{
  "build": {
    "arduino": {
      "ldscript": "esp32s3_out.ld",
      "memory_type": "qio_opi"
    },
    "core": "esp32",
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "qio",
    "mcu": "esp32s3",
    "variant": "esp32s3",
    "extra_flags": [
      "-D ARDUINO_ESP32S3_DEV",
      "-D ARDUINO_USB_MODE=1",
      "-D ARDUINO_USB_CDC_ON_BOOT=1",
