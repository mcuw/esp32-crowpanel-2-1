      "-D ARDUINO_RUNNING_CORE=1",
      "-D ARDUINO_EVENT_RUNNING_CORE=1"
    ]
  },
  "connectivity": [
    "wifi",
    "bluetooth",
    "usb"
  ],
  "debug": {
    "default_tool": "esp-builtin",
